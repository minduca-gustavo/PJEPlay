{
  "version": "2.1.21",
  "short_name": "Rota PJE",
  "name": "Rota PJE",
  "description": "Atua como auxiliar para a execução de tarefas no PJE, fornecendo um roteiro operacional e recursos adicionais para facilitar o uso do sistema.",
  "author": "Rota PJE",
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "pje-play@extensao.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "action": {
    "default_popup": "navegador/paginas/menu/pagina.htm",
    "default_icon": "imagens/icon32.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.jus.br/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.jus.br/*"
      ],
      "resources": [
        "utils/pdfjs.mjs",
        "utils/pdfjs.worker.mjs",
        "imagens/*.png",
        "rota/formatadores.js",
        "modulos/definicoes.js",
        "modulos/relatar.js",
        "navegador/paginas/menu/menu-gestor.htm",
        "funcoes-botao-rota/assistente/assistente.html",
        "funcoes-botao-rota/assistente/assistente.css",
        "funcoes-botao-rota/assistente/assistente.js",
        "funcoes-botao-rota/assistente/conector.js",
        "rota/acoes.js",
        "rota/configuracao.js",
        "rota/estado.js",
        "rota/cache.js",
        "rota/componentes.js",
        "modulos/dom.js",
        "modulos/execucao.js",
        "modulos/navegador.js",
        "modulos/texto.js",
        "funcoes-botao-rota/tarefas/index.js",
        "funcoes-botao-rota/tarefas/balcao-virtual/roteiro.js",
        "funcoes-botao-rota/tarefas/triagem-inicial/roteiro.js",
        "funcoes-botao-rota/tarefas/con2-prazo-vencido/roteiro-con2-prazo-vencido.js",
        "funcoes-botao-rota/tarefas/visualizador-de-documentos/roteiro-visualizador-de-documentos.js",
        "funcoes-botao-rota/tarefas/pos-triagem/roteiro.js"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "melhor-leitura/conteudo.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.jus.br/pjekz/*"
      ],
      "js": [
        "rota/interceptador-xhr.js"
      ],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.jus.br/*"
      ],
      "js": [
        "modulos/console.js",
        "modulos/definicoes.js",
        "modulos/relatar.js",
        "modulos/dom.js",
        "modulos/execucao.js",
        "modulos/navegador.js",
        "modulos/texto.js",
        "rota/configuracao.js",
        "rota/estado.js",
        "rota/cache.js",
        "rota/modelo.js",
        "rota/interceptador.js",
        "rota/interceptador_documento.js",
        "modulos/evita_queda.js",
        "modulos/seletores.js",
        "rota/ui.js",
        "modulos/movimentar.js",
        "funcoes-botao-rota/pintura.js",
        "funcoes-botao-rota/janelas.js",
        "funcoes-botao-rota/botao-rota.js",
        "pje/iniciar.js",
        "pje/funcoes-da-planilha.js",
        "pje/porta-de-entrada.js",
        "pje/sf-botoes.js",
        "assistentes-flutuantes/compilador-de-assistentes.js",
        "assistentes-flutuantes/consulta-qualquer-oj.js",
        "pje/funcoes-fita-superior-janela-detalhes.js",
        "pje/sigeo-filtra-vt-final.js",
        "pje/gigs.js",
        "rota/acoes.js",
        "rota/formatadores.js",
        "rota/componentes.js",
        "assistentes-flutuantes/leitura_dinamica_documentos.js",
        "assistentes-flutuantes/filtros_novos.js",
        "assistentes-flutuantes/assistente-assinatura.js",
        "assistentes-flutuantes/pericias-aud.js",
        "assistentes-flutuantes/quadro-juizesSempreVisivel.js",
        "pje/teste.js",
        "funcoes-botao-rota/tarefas/index.js",
        "funcoes-botao-rota/tarefas/balcao-virtual/roteiro.js",
        "funcoes-botao-rota/tarefas/triagem-inicial/roteiro.js",
        "funcoes-botao-rota/tarefas/con2-prazo-vencido/roteiro-con2-prazo-vencido.js",
        "funcoes-botao-rota/tarefas/visualizador-de-documentos/roteiro-visualizador-de-documentos.js",
        "funcoes-botao-rota/tarefas/pos-triagem/roteiro.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "modulos/definicoes.js",
      "modulos/relatar.js",
      "rota/configuracao.js",
      "funcoes-botao-rota/tarefas/index.js",
      "navegador/segundo-plano.js"
    ]
  },
  "icons": {
    "16": "imagens/icon16.png",
    "32": "imagens/icon32.png",
    "48": "imagens/icon48.png",
    "128": "imagens/icon128.png"
  }
}